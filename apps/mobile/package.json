{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-safe-area-context",
        "typescript"
      ]
    }
  },
  "scripts": {
    "dev": "pnpm exec expo start --dev-client --lan --port 8081",
    "eas-build-post-install": "node ./scripts/eas-post-install.mjs",
    "storybook:start": "EXPO_PUBLIC_STORYBOOK_ENABLED=1 pnpm exec expo start -c --lan",
    "storybook:generate": "EXPO_PUBLIC_STORYBOOK_ENABLED=1 pnpm exec sb-rn-get-stories --config-path ./.rnstorybook && biome check --write .rnstorybook/storybook.requires.ts",
    "storybook:watch": "pnpm run storybook:generate && pnpm exec chokidar \"**/*.stories.{ts,tsx,js,jsx,mdx}\" \".rnstorybook/**/*.{ts,tsx,js,jsx}\" -c \"pnpm run storybook:generate\"",
    "android:dev": "pnpm exec dotenv -o -e .env.local -- pnpm exec expo run:android",
    "ios": "pnpm exec expo run:ios",
    "web": "pnpm exec expo start --web",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "pnpm run test:vitest && pnpm run test:jest",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:jest": "jest --config ./jest.config.mjs --runInBand",
    "test:jest:file": "jest --config ./jest.config.mjs --runInBand --",
    "test:jest:watch": "jest --config ./jest.config.mjs --watch",
    "check-types": "tsc --noEmit",
    "watch": "pnpm exec concurrently \"tsc --noEmit --watch --preserveWatchOutput\" \"pnpm exec chokidar '**/*.{ts,tsx,js,jsx,json,css}' -c 'biome lint .'\"",
    "test:e2e": "maestro test .maestro/flows/smoke/app-launch.yaml",
    "android": "expo run:android"
  },
  "dependencies": {
    "@deancochran/ftms": "0.4.0",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "57.0.19",
    "@garmin/fitsdk": "^21.213.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/tailwindcss": "workspace:*",
    "@repo/ui": "workspace:*",
    "@rn-primitives/portal": "^1.5.3",
    "@sentry/react-native": "^8.23.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.102.0",
    "@trpc/react-query": "^11.18.0",
    "buffer": "^6.0.3",
    "date-fns": "^4.4.0",
    "expo": "^57.0.21",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "immer": "^10.2.0",
    "lucide-react-native": "^0.577.0",
    "nativewind": "5.0.0-preview.3",
    "pako": "^2.2.0",
    "posthog-react-native": "^4.63.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-css": "^3.0.7",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "victory-native": "41.20.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@jest/globals": "29.7.0",
    "@posthog/cli": "^0.15.0",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-ondevice-actions": "^10.5.4",
    "@storybook/addon-ondevice-controls": "^10.5.4",
    "@storybook/react-native": "^10.5.4",
    "@swc/core": "^1.16.1",
    "@swc/jest": "0.2.38",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/pako": "^2.0.4",
    "@types/react": "19.2.14",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.4",
    "dotenv-cli": "^11.0.0",
    "eas-build-cache-provider": "^16.30.0",
    "jest": "29.7.0",
    "lightningcss": "1.30.1",
    "metro-cache": "0.84.5",
    "postcss": "8.5.26",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
