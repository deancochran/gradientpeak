# Compatibility view for existing flow variable names. Values stay in ignored fixtures.env.
# Use `node .maestro/fixture-tool.mjs inventory --domain <domain>` for validated domain ownership.
# Passwords, tokens, keys, and secrets must remain blank in this tracked example.
STANDARD_USER_EMAIL=
STANDARD_USER_PASS=

# Public auth forms. Reset and sign-up addresses must be routable by the local E2E mail fixture;
# each sign-up address must be unused at the start of its independently run flow.
RESET_EMAIL=
SIGNUP_EMAIL_A=
SIGNUP_EMAIL_B=
SIGNUP_PASSWORD=

# Contract-flow users. A/B accounts are separate and start with unfinished onboarding.
ONBOARDING_FOLLOW_USER_EMAIL_A=
ONBOARDING_FOLLOW_USER_PASS_A=
ONBOARDING_FOLLOW_USER_EMAIL_B=
ONBOARDING_FOLLOW_USER_PASS_B=
