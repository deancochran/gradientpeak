{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradientpeak.local/schemas/maestro-fixture-receipt-v2.json",
  "title": "GradientPeak Maestro fixture receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "receiptId",
    "createdAt",
    "invocation",
    "evidence",
    "source",
    "fixture",
    "application",
    "provision",
    "runtime",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "receiptId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "invocation": {
      "type": "object",
      "required": ["runId", "leaseId"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,63}$" },
        "leaseId": { "type": "string", "pattern": "^lease-[0-9a-f-]{36}$" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "isRuntimeProof"],
      "properties": {
        "kind": {
          "enum": [
            "fixture-provision",
            "fixture-reset",
            "preflight",
            "lifecycle-run",
            "maestro-runtime"
          ]
        },
        "isRuntimeProof": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "required": ["flow", "sourceIdentity", "variation"],
      "properties": {
        "flow": { "type": "string" },
        "sourceIdentity": { "type": "string" },
        "variation": { "enum": ["a", "b", "baseline"] },
        "commit": { "type": ["string", "null"] },
        "base": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "fixture": {
      "type": "object",
      "required": [
        "contractId",
        "revision",
        "instance",
        "contractFingerprint",
        "status",
        "actorIds",
        "recordIds",
        "inventory"
      ],
      "properties": {
        "contractId": { "type": "string" },
        "revision": { "type": "string" },
        "instance": { "type": "string" },
        "contractFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "enum": ["supported", "manual", "intentional-red", "unsupported"] },
        "actorIds": { "type": "array", "items": { "type": "string" } },
        "recordIds": { "type": "array", "items": { "type": "string" } },
        "inventory": {
          "type": "object",
          "required": ["actors", "records"],
          "properties": {
            "actors": { "type": "array", "items": { "$ref": "#/$defs/inventoryEntry" } },
            "records": { "type": "array", "items": { "$ref": "#/$defs/inventoryEntry" } }
          },
          "additionalProperties": false
        }
      }
    },
    "application": {
      "type": "object",
      "required": ["device", "platform", "appId", "scheme"],
      "properties": {
        "device": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] },
        "appId": { "type": "string" },
        "scheme": { "type": "string" }
      }
    },
    "provision": { "$ref": "#/$defs/disposition" },
    "runtime": {
      "type": "object",
      "required": ["status", "maestroEvidencePath"],
      "properties": {
        "status": { "enum": ["NOT_RUN", "PASSED", "FAILED"] },
        "maestroEvidencePath": { "type": ["string", "null"] }
      }
    },
    "cleanup": { "$ref": "#/$defs/disposition" }
  },
  "$defs": {
    "inventoryEntry": {
      "type": "object",
      "required": ["category", "id"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "required": ["status", "at", "detail"],
      "properties": {
        "status": { "enum": ["NOT_ATTEMPTED", "BLOCKED", "READY", "CLEAN", "FAILED"] },
        "at": { "type": ["string", "null"] },
        "detail": { "type": "string" }
      }
    }
  }
}
