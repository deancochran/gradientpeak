{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradientpeak.local/schemas/maestro-fixture-policy-v1.json",
  "title": "GradientPeak Maestro fixture policy",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "contractIdPrefix",
    "allowedStatuses",
    "runtimeVariables",
    "inheritedFlowVariables",
    "service",
    "domains"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "contractIdPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "allowedStatuses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["supported", "manual", "intentional-red", "unsupported"] }
    },
    "runtimeVariables": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inheritedFlowVariables": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "service": {
      "type": "object",
      "required": [
        "enableVariable",
        "urlVariable",
        "allowedHosts",
        "healthPath",
        "provisionPath",
        "resetPath",
        "protocol"
      ],
      "properties": {
        "enableVariable": { "const": "MAESTRO_FIXTURE_ENABLE" },
        "urlVariable": { "const": "MAESTRO_FIXTURE_SERVICE_URL" },
        "allowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["127.0.0.1", "::1"] }
        },
        "healthPath": { "const": "/v2/health" },
        "provisionPath": { "const": "/v2/scenarios/provision" },
        "resetPath": { "const": "/v2/scenarios/reset" },
        "protocol": { "const": "gradientpeak-maestro-fixtures/v2" },
        "provisionReceiptMaxAgeMs": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": { "description": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
