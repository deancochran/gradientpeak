# GradientPeak web local development template.
# Copy to apps/web/.env.local and fill in provider/client secrets as needed.

APP_URL=http://100.119.109.24:3000
# Optional comma-separated exact browser origins used for local/Tailscale development.
AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=local-development-secret-change-me

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PRIVATE_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PRIVATE_SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OAUTH_CALLBACK_BASE_URL=http://100.119.109.24:3000
# Generate once per environment with: openssl rand -base64 32
PROVIDER_TOKEN_ENCRYPTION_KEY=
WAHOO_WEBHOOK_TOKEN=
# Comma-separated client-IP headers set and overwritten by your trusted proxy (for example: cf-connecting-ip).
TRUSTED_PROXY_IP_HEADERS=
# Optional comma-separated exact hosts or *.domain patterns added to the default *.wahooligan.com allowlist.
WAHOO_ACTIVITY_FILE_ALLOWED_HOSTS=
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Garmin OAuth 2.0 PKCE application credentials. Register the development callback exactly as:
# https://dev.gradientpeak.com/api/integrations/callback/garmin
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Dedicated HMAC secret for deterministic outbound activity identities (minimum 32 characters).
STRAVA_UPLOAD_EXTERNAL_ID_SECRET=
# Dedicated high-entropy HMAC key for opaque, deterministic completed-activity upload IDs.
STRAVA_UPLOAD_EXTERNAL_ID_SECRET=
# Random callback verification token configured when the Strava subscription is created.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Numeric ID returned by Strava after callback verification succeeds.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
STRAVA_PROVIDER_SYNC_LEASE_MS=600000
STRAVA_PROVIDER_SYNC_DRAIN_LIMIT=4

# Server-only chatbot provider configuration. Set account-approved OpenAI model IDs;
# the chatbot never accepts a model ID from a browser request. Jev routing is optional
# and defaults to fixed reasoning when CHATBOT_MODEL_ROUTING_MODE is left unset.
OPENAI_API_KEY=
CHATBOT_OPENAI_FAST_MODEL=
CHATBOT_OPENAI_REASONING_MODEL=
CHATBOT_MODEL_ROUTING_MODE=fixed
CHATBOT_ROUTER_MAX_INPUT_CHARS=4000
# Optional Jev key. Required when CHATBOT_MODEL_ROUTING_MODE=jev or
# CHATBOT_JEV_DECISIONS_ENABLED=true. Opt in only after a separate processor
# data-policy/retention review. This is not an authorization to send sensitive data.
# Pin a release; `jev-latest` may drift its confidence distribution between deploys.
TYPESAFE_API_KEY=
CHATBOT_JEV_MODEL=jev-1.14.0
# 0.75 is an UNVALIDATED starting policy. Choice confidence/concentration is not
# correctness. Run representative synthetic tier evaluation before production Jev enablement.
CHATBOT_JEV_CONFIDENCE_THRESHOLD=0.75
CHATBOT_JEV_TIMEOUT_MS=2000
CHATBOT_JEV_MAX_RETRIES=0
# Separate from routing. When true, the read-only decision helper sends bounded model-supplied
# context/candidates/preferences to TypeSafe. The host does not automatically fetch full profiles
# or histories, follow URLs, or execute code, but the model can copy excerpts it sees (including
# sensitive conversation or API material). Prompts are guidance, not DLP or provenance enforcement.
CHATBOT_JEV_DECISIONS_ENABLED=false

# Explicitly allow only installed mobile deep-link schemes.
AUTH_MOBILE_CALLBACK_URL=gradientpeak-dev://callback?intent=post-sign-in
AUTH_MOBILE_SCHEME=gradientpeak-dev
AUTH_ALLOWED_DEEP_LINK_PREFIXES=gradientpeak-dev://,gradientpeak://
OAUTH_MOBILE_CALLBACK_URL=gradientpeak-dev://integrations

AUTH_EMAIL_MODE=smtp
AUTH_EMAIL_FROM=GradientPeak Local <noreply@localhost>
AUTH_EMAIL_REPLY_TO=noreply@localhost
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=54325
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_SECURE=false

# Sentry and PostHog telemetry. These are safe to leave blank for local work.
# Fill them when you want the local dev server/browser to send events upstream.
APP_ENV=development
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Replay requires this separate opt-in and a nonzero sample rate.
VITE_ENABLE_SENTRY_REPLAY=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SECRET_KEY=
POSTHOG_PERSONAL_API_KEY=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_DEBUG=0
