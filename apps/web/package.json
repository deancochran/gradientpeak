{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog:export": "tsx scripts/export-activity-plan-catalog.tsx",
    "catalog:measure": "tsx scripts/measure-activity-plan-portfolio.ts",
    "dev": "pnpm run dev:tunnel",
    "dev:local": "concurrently --names app,provider-workers --kill-others-on-fail \"pnpm run dev:app\" \"pnpm run dev:provider-drains\"",
    "dev:tunnel": "concurrently --names app,provider-workers,cloudflared --kill-others-on-fail \"pnpm run dev:app:tunnel\" \"pnpm run dev:provider-drains:tunnel\" \"pnpm run dev:webhooks\"",
    "dev:e2e": "pnpm --dir ../.. db:e2e:start && pnpm --dir ../.. db:e2e:migrate && pnpm run dev:app:e2e",
    "dev:app": "pnpm exec dotenv -o -e .env.local -- sh -c 'VITE_CACHE_DIR=/tmp/gradientpeak-web-vite-manual NODE_OPTIONS=\"--import ./instrument.server.mjs\" vite dev --host 0.0.0.0 --port 3000 --strictPort'",
    "dev:app:e2e": "node scripts/start-e2e-web.mjs",
    "dev:app:tunnel": "pnpm exec dotenv -o -e .env.local -e .env.tunnel -- sh -c 'VITE_CACHE_DIR=/tmp/gradientpeak-web-vite-manual NODE_OPTIONS=\"--import ./instrument.server.mjs\" vite dev --host 0.0.0.0 --port 3000 --strictPort'",
    "sentry:smoke": "pnpm exec dotenv -o -e .env.local -- sh -c 'NODE_OPTIONS=\"--import ./instrument.server.mjs\" tsx scripts/sentry-diagnostic-smoke.ts'",
    "dev:provider-drains": "pnpm exec dotenv -o -e .env.local -- node scripts/drain-provider-sync.mjs",
    "dev:provider-drains:tunnel": "pnpm exec dotenv -o -e .env.local -e .env.tunnel -- node scripts/drain-provider-sync.mjs",
    "dev:provider-drains:once": "pnpm exec dotenv -o -e .env.local -- node scripts/drain-provider-sync.mjs --once",
    "start:provider-drains": "node scripts/drain-provider-sync.mjs",
    "start:provider-drains:once": "node scripts/drain-provider-sync.mjs --once",
    "dev:wahoo-drain": "pnpm run dev:provider-drains",
    "dev:wahoo-drain:tunnel": "pnpm run dev:provider-drains:tunnel",
    "dev:wahoo-drain:once": "pnpm run dev:provider-drains:once",
    "dev:cloudflared": "node scripts/start-cloudflared.mjs",
    "dev:webhooks": "pnpm run dev:cloudflared",
    "build": "vite build && cp instrument.server.mjs sentry-config.mjs .output/server/",
    "check-types": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/run-playwright.test.ts scripts/__tests__/drain-provider-sync.test.mjs",
    "test:serve": "vite dev --host 127.0.0.1 --strictPort",
    "test:e2e": "node scripts/run-playwright.mjs",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@posthog/react": "^1.10.4",
    "@react-pdf/renderer": "^4.9.0",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/tailwindcss": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/tanstackstart-react": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^2.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260410-164248-8ab58a4b",
    "pg": "^8.23.0",
    "posthog-js": "^1.418.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "^1.62.1",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/builder-vite": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tanstack/devtools-vite": "^0.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^28.1.0",
    "storybook": "^10.5.10",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
