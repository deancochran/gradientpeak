{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:tunnel",
    "dev:local": "concurrently --names app,wahoo-worker --kill-others-on-fail \"pnpm run dev:app\" \"pnpm run dev:wahoo-drain\"",
    "dev:tunnel": "concurrently --names app,wahoo-worker,ngrok --kill-others-on-fail \"pnpm run dev:app\" \"pnpm run dev:wahoo-drain\" \"pnpm run dev:ngrok\"",
    "dev:e2e": "pnpm --filter @repo/db dev:setup && pnpm run test:serve",
    "dev:app": "pnpm exec dotenv -o -e .env.local -- sh -c 'NODE_OPTIONS=\"--import ./instrument.server.mjs\" vite dev --host 0.0.0.0 --port 3000 --strictPort'",
    "dev:wahoo-drain": "pnpm exec dotenv -o -e .env.local -- node scripts/drain-wahoo-provider-sync.mjs",
    "dev:wahoo-drain:direct": "pnpm exec dotenv -o -e .env.local -- vite-node scripts/drain-wahoo-provider-sync-direct.ts",
    "dev:wahoo-drain:once": "pnpm exec dotenv -o -e .env.local -- node scripts/drain-wahoo-provider-sync.mjs --once",
    "dev:ngrok": "node scripts/start-ngrok.mjs",
    "dev:scan": "VITE_ENABLE_REACT_SCAN=1 pnpm run dev:app",
    "build": "vite build && cp instrument.server.mjs sentry-config.mjs .output/server/",
    "check-types": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/run-playwright.test.ts",
    "test:serve": "vite dev --host 127.0.0.1 --strictPort",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:runner": "node --test scripts/run-playwright.test.ts",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.1",
    "@opentelemetry/core": "^2.10.0",
    "@posthog/react": "^1.10.3",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/tailwindcss": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/tanstackstart-react": "^10.68.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "^1.168.23",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260410-164248-8ab58a4b",
    "pg": "^8.22.0",
    "posthog-js": "^1.407.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.83.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "^1.62.0",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^28.1.0",
    "react-scan": "^0.5.7",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  }
}
