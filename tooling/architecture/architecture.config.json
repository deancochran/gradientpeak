  "exceptions": [
    {
      "id": "phase0-core-fit-sdk-direction",
      "category": "dependency-direction",
      "path": "packages/core/lib/fit-sdk-parser.ts",
      "maxCount": 1,
      "owner": "architecture-working-group",
      "expiresOn": "2027-07-01",
      "reason": "Server-only FIT SDK adapter is retained in core during Phase 0 and is not a workspace dependency reversal."
    },
    {
      "id": "better-auth-expo-storage-cast",
      "category": "unsafe-as-any",
      "path": "packages/auth/src/client/expo.ts",
      "maxCount": 1,
      "owner": "auth",
      "expiresOn": "2027-07-01",
      "reason": "Better Auth's Expo storage adapter types do not expose the React Native storage shape; the runtime adapter is constrained at this platform boundary."
    }
  ],
  "reviewedIgnores": [
    {
      "id": "architecture-fixtures",
      "path": "tooling/architecture/fixtures/**/*",
      "owner": "architecture-working-group",
      "expiresOn": "2027-07-01",
      "reason": "Deliberately invalid scanner fixtures are validated by the architecture test harness rather than repository verification commands."
    }
  ],
  "scanExcludes": ["tooling/architecture/fixtures/**/*"]
}
