      "query-string-dependency-patch": ["patches/query-string@7.1.3.patch"],
      "test-fixture": ["**/fixtures/**/*"]
    },
    "categoryCommands": {
      "source": "pnpm check-types && pnpm lint",
      "configuration": "pnpm check",
      "styles": "pnpm check",
      "database": "pnpm verify:db",
      "templates": "pnpm check && pnpm verify:db",
      "documentation": "pnpm check",
      "scripts": "pnpm check",
      "ui-platform-marker": "pnpm check:test-structure",
      "repository-metadata": "pnpm check",
      "query-string-dependency-patch": "pnpm install --frozen-lockfile && pnpm test:security:query-string",
      "test-fixture": "pnpm test"
    }
