# ------------------------------
# Root Monorepo Gitignore
# Covers apps/ and packages/
# ------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
*.node

# Local env files
.env*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example


# Testing
# Local exports and review evidence are not source files.
/artifacts/catalog-downloads/
/artifacts/catalog-fallback-alignment/
/artifacts/core-acceptance-rehearsal/
/lint-*-before.txt
coverage/
*.lcov
coverage/**/*
**/test-results/
**/playwright-report/
**/blob-report/

# Turbo
.turbo/
.tmp/

# Vercel
.vercel/

# Static site outputs
out/
**/storybook-static/

# ------------------------------
# Expo / React Native
# ------------------------------
.expo/
.expo-shared/
*.iml
*.apk
*.aar
*.jks
web-build/

ios/
android/

# Metro bundler cache
.metro-cache/
*.packager

# ------------------------------
# Shared Packages (packages/)
# ------------------------------


# Supabase generated stuff
supabase/.temp/
supabase/.branches/

# Worktree artifacts
.worktrees/
# ------------------------------
# Logs & Debug
# ------------------------------
logs/
.logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/.maestro/*.log
**/.maestro/artifacts/
**/.maestro/cache/
**/.maestro/home/
**/.maestro/utils/
**/.maestro/actors/*.env
**/.maestro/fixtures.env
packages/*/dist/
packages/*/lib/
# ------------------------------
# Misc
# ------------------------------
.DS_Store
*.pem
*.keystore
*.gradle
*.hprof
*.swp

# IDE/editor
.vscode/
.idea/
*.log
*.tsbuildinfo
.aider*

# OpenCode / local coordinator config
.opencode/
opencode.json
AGENTS_AUDIT.md

# Local config
.config/

# Claude Code
.claude/

# CLAUDE.md may still be tracked as project documentation.
