{
  "name": "gradientpeak",
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "concurrently": "^9.2.1",
    "kill-port-cli": "^1.0.2",
    "knip": "^6.4.1",
    "lefthook": "^2.1.6",
    "turbo": "^2.6.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "audit:forms": "node tooling/forms/audit-forms.mjs",
    "check": "biome check apps packages tooling tests docs .github README.md package.json pnpm-workspace.yaml turbo.json biome.json vitest.parity.config.ts && pnpm check:architecture && pnpm check:guidance && pnpm check:test-structure",
    "check:ci": "biome ci apps packages tooling tests docs .github README.md package.json pnpm-workspace.yaml turbo.json biome.json vitest.parity.config.ts && pnpm check:architecture && pnpm check:guidance && pnpm check:test-structure",
    "check:architecture": "node tooling/architecture/check-architecture.mjs",
    "check:architecture:baseline": "node tooling/architecture/check-architecture.mjs --write-baseline",
    "check:guidance": "node tooling/architecture/check-guidance.mjs",
    "doctor": "node tooling/doctor.mjs",
    "multisport:legacy-denylist": "node --test tooling/multisport/legacy-denylist.self-test.mjs && node tooling/multisport/legacy-denylist.mjs",
    "dev": "turbo run dev",
    "dev:all": "turbo run dev",
    "dev:clean": "pnpm exec k 3000 3100 8081 8082 || true && pnpm run self-host:down >/dev/null 2>&1 || true && printf '[dev-clean] local web/mobile dev servers and Supabase stopped\n'",
    "dev:e2e": "turbo run dev:e2e --parallel --ui tui",
    "dev:web": "pnpm --filter web dev",
    "dev:web:local": "pnpm --filter web dev:local",
    "dev:web:tunnel": "pnpm --filter web dev:tunnel",
    "dev:wahoo-drain": "pnpm --filter web dev:wahoo-drain",
    "dev:wahoo-drain:direct": "pnpm --filter web dev:wahoo-drain:direct",
    "dev:wahoo-drain:once": "pnpm --filter web dev:wahoo-drain:once",
    "dev:web:scan": "pnpm --filter web dev:scan",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:e2e:web": "pnpm --filter web dev:e2e",
    "dev:e2e:mobile": "pnpm --filter mobile dev:e2e",
    "watch": "turbo run watch",
    "knip": "POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres knip --dependencies",
    "knip:full": "POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres knip",
    "lint": "biome lint apps packages tooling tests docs .github README.md package.json pnpm-workspace.yaml turbo.json biome.json vitest.parity.config.ts",
    "lint:fix": "biome lint --write apps packages tooling tests docs .github README.md package.json pnpm-workspace.yaml turbo.json biome.json vitest.parity.config.ts",
    "format": "biome format --write apps packages tooling tests docs .github README.md package.json pnpm-workspace.yaml turbo.json biome.json vitest.parity.config.ts",
    "prepare": "lefthook install",
    "db:start": "pnpm --filter @repo/db db:start",
    "db:stop": "pnpm --filter @repo/db db:stop",
    "db:status": "pnpm --filter @repo/db db:status",
    "db:update": "pnpm --filter @repo/db db:update",
    "db:downgrade": "pnpm --filter @repo/db db:downgrade",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:migration:new": "pnpm --filter @repo/db db:migration:new",
    "db:migration:sync": "pnpm --filter @repo/db db:migration:sync",
    "db:migration:check": "pnpm --filter @repo/db db:migration:check",
    "db:migration:list": "pnpm --filter @repo/db db:migration:list",
    "db:migration:up": "pnpm --filter @repo/db db:migration:up",
    "db:migration:down": "pnpm --filter @repo/db db:migration:down",
    "db:diff": "pnpm --filter @repo/db db:diff",
    "db:lint:local": "pnpm --filter @repo/db db:lint:local",
    "db:schema:fingerprint": "pnpm --filter @repo/db db:schema:fingerprint",
    "db:drizzle:studio": "pnpm --filter @repo/db db:drizzle:studio",
    "check-types": "turbo run check-types && pnpm check:typescript-strictness",
    "check:typescript-strictness": "node tooling/typescript/strictness-ratchet.mjs",
    "check:typescript-strictness:baseline": "node tooling/typescript/strictness-ratchet.mjs --write-baseline --reviewed",
    "test": "pnpm test:workspaces && pnpm test:parity && pnpm test:architecture",
    "test:file": "node tooling/testing/cli.mjs --run --path",
    "test:scope": "node tooling/testing/cli.mjs",
    "test:feature": "node tooling/testing/cli.mjs --run --feature",
    "test:changed": "node tooling/testing/cli.mjs --run --changed",
    "verify:feature": "node tooling/testing/cli.mjs --verify --feature",
    "verify:changed": "node tooling/testing/cli.mjs --verify --changed",
    "check:test-structure": "node tooling/testing/cli.mjs --check-structure",
    "check:test-structure:baseline": "node tooling/testing/cli.mjs --write-structure-baseline",
    "test:workspaces": "turbo run test",
    "test:architecture": "node --test tooling/architecture/check-architecture.test.mjs tooling/architecture/check-guidance.test.mjs tooling/testing/planner.test.mjs tooling/testing/structure.test.mjs",
    "test:typescript-strictness": "pnpm --filter @repo/typescript-config test",
    "test:api": "pnpm --filter @repo/api test",
    "test:parity": "pnpm exec vitest run --config vitest.parity.config.ts",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "verify:static": "pnpm check && pnpm check-types",
    "verify:api": "pnpm --filter @repo/api verify:api",
    "verify:db": "pnpm --filter @repo/db db:verify:static",
    "verify": "pnpm verify:static && pnpm test",
    "verify:full": "pnpm verify && pnpm knip",
    "quality:agent": "pnpm check && pnpm check-types && pnpm test && pnpm knip",
    "self-host:up": "pnpm --filter @repo/db self-host:up",
    "self-host:down": "pnpm --filter @repo/db self-host:down"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "version": "1.0.0"
}
