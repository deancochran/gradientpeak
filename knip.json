{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error"
  },
  "treatConfigHintsAsErrors": true,
  "ignoreBinaries": ["cloudflared", "printf"],
  "ignoreFiles": ["apps/web/src/routeTree.gen.ts"],
  "workspaces": {
    "apps/mobile": {
      "ignoreDependencies": [
        "@react-native-community/netinfo",
        "buffer",
        "expo-blur",
        "expo-updates",
        "dotenv-cli",
        "eas-build-cache-provider"
      ],
      "paths": {
        "app.config": ["./app.config.ts"],
        "@/*": ["./*"],
        "@repo/auth": ["../../packages/auth/src/client.ts"],
        "@repo/auth/*": [
          "../../packages/auth/src/*",
          "../../packages/auth/src/contracts/*",
          "../../packages/auth/src/client/*",
          "../../packages/auth/src/runtime/*"
        ]
      }
    },
    "apps/web": {
      "ignoreDependencies": ["@tanstack/router-plugin", "tailwindcss"]
    }
  }
}
