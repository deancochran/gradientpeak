{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "default": "./src/validation/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc",
    "dev:setup": "tsx scripts/local-db-command.ts start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "db:start": "tsx scripts/local-db-command.ts start",
    "db:stop": "tsx scripts/local-db-command.ts stop",
    "db:status": "tsx scripts/local-db-command.ts status",
    "db:update": "tsx scripts/local-db-command.ts migration up --local",
    "db:downgrade": "tsx scripts/local-db-command.ts migration down --local",
    "db:reset": "tsx scripts/local-db-command.ts db reset --local",
    "db:migration:new": "tsx scripts/migration-workflow.ts",
    "db:migration:sync": "tsx scripts/migration-workflow.ts sync",
    "db:migration:integrity": "tsx scripts/migration-workflow.ts check",
    "db:migration:fixtures": "tsx scripts/verify-migration-fixtures.ts --disposable --local",
    "db:migration:fresh": "tsx scripts/verify-fresh-target.ts --disposable --local --diff",
    "db:migration:ledger:pre": "tsx scripts/check-migration-ledger.ts --pre-reconciliation --local",
    "db:migration:ledger:post": "tsx scripts/check-migration-ledger.ts --post-reconciliation --local",
    "db:migration:check": "pnpm db:migration:integrity",
    "db:migration:list": "tsx scripts/local-db-command.ts migration list --local",
    "db:migration:up": "tsx scripts/local-db-command.ts migration up --local",
    "db:migration:down": "tsx scripts/local-db-command.ts migration down --local",
    "db:diff": "tsx scripts/verify-fresh-target.ts --disposable --local --diff",
    "db:schema:check": "tsx scripts/check-schema-parity.ts",
    "db:schema:fingerprint": "tsx scripts/check-schema-fingerprint.ts",
    "db:schema:fingerprint:write": "tsx scripts/check-schema-fingerprint.ts --write",
    "db:security:check": "tsx scripts/verify-public-table-security.ts",
    "db:lint:local": "tsx scripts/local-db-command.ts db lint --local --schema public --fail-on warning",
    "db:verify:static": "pnpm check-types && pnpm lint && pnpm db:migration:check",
    "db:verify": "pnpm db:verify:static && pnpm db:migration:fresh && pnpm db:migration:fixtures",
    "db:verify:reconciled": "pnpm db:migration:ledger:post && pnpm db:schema:check && pnpm db:schema:fingerprint",
    "db:verify:activity-consolidation": "tsx scripts/with-local-db-url.ts tsx scripts/verify-activity-consolidation.ts",
    "db:drizzle:studio": "tsx scripts/with-local-db-url.ts drizzle-kit studio --config drizzle.config.ts",
    "self-host:up": "tsx scripts/local-db-command.ts start",
    "self-host:down": "tsx scripts/local-db-command.ts stop",
    "functions:serve": "tsx scripts/local-db-command.ts functions serve",
    "functions:deploy": "tsx scripts/local-db-command.ts functions deploy",
    "functions:new": "tsx scripts/local-db-command.ts functions new",
    "seed-templates": "tsx scripts/seed-templates.ts",
    "seed-system-routes": "tsx scripts/seed-system-routes.ts",
    "seed-training-plans": "tsx scripts/seed-training-plan-templates.ts",
    "studio": "pnpm drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.16.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "supabase": "2.109.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.2"
  }
}
