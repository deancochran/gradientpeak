{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "default": "./src/validation/index.ts"
    },
    "./testing/disposable-database": {
      "types": "./scripts/disposable-database-test-harness.ts",
      "default": "./scripts/disposable-database-test-harness.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "tsx scripts/canonical-json.test.ts && tsx scripts/activity-plan-revision-schema.test.ts && tsx scripts/activity-analysis-revisions-schema.test.ts && tsx scripts/activity-efforts-schema.test.ts && tsx scripts/group-event-rsvp-schema.test.ts && tsx scripts/performance-calibration-schema.test.ts && tsx scripts/training-plan-calendar-ownership-schema.test.ts && tsx scripts/mobile-recording-upload-claim-schema.test.ts && tsx scripts/prelaunch-schema-preparation.test.ts && tsx scripts/system-content-seed-parity.test.ts && tsx scripts/verify-core-enum-parity.ts && tsx scripts/verify-edge-function-safety.test.ts && tsx scripts/verify-edge-function-safety.ts && tsx scripts/storage-assets-contract.test.ts",
    "test:db": "pnpm db:activity-file-ingestions:test && pnpm db:coaching:foundation:test && pnpm db:coaching:authorization:test",
    "dev:setup": "tsx scripts/local-db-command.ts ensure-started",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "db:start": "tsx scripts/local-db-command.ts start",
    "db:stop": "tsx scripts/local-db-command.ts stop",
    "db:status": "tsx scripts/local-db-command.ts status",
    "db:baseline:check": "tsx scripts/baseline-workflow.ts check",
    "db:baseline:workflow:test": "tsx scripts/baseline-workflow.test.ts",
    "db:fresh:verify": "tsx scripts/verify-fresh-target.ts --disposable --local --diff",
    "db:fresh:verify:determinism": "pnpm db:fresh:verify",
    "db:baseline:list": "tsx scripts/local-db-command.ts migration list --local",
    "db:reset:mvp": "tsx scripts/reset-mvp.ts",
    "db:reset:mvp:test": "tsx scripts/reset-mvp.test.ts",
    "db:diff": "tsx scripts/verify-fresh-target.ts --disposable --local --diff",
    "db:schema:check": "tsx scripts/check-schema-parity.ts",
    "db:schema:fingerprint": "tsx scripts/check-schema-fingerprint.ts",
    "db:security:check": "tsx scripts/verify-public-table-security.ts",
    "db:lint:local": "tsx scripts/local-db-command.ts db lint --local --schema public --fail-on warning",
    "db:verify:static": "pnpm check-types && pnpm lint && pnpm test && pnpm db:disposable-target:safety:test && pnpm db:baseline:check && pnpm db:baseline:workflow:test && pnpm db:reset:mvp:test",
    "db:disposable-target:safety:test": "tsx scripts/disposable-target-safety.test.ts",
    "db:verify": "pnpm db:verify:static && pnpm test:db && pnpm db:fresh:verify && pnpm db:fresh:verify:determinism && pnpm db:benchmark:planned-day-summary && pnpm db:athlete-state-replay:plan:test",
    "db:athlete-state-replay:plan:test": "tsx scripts/verify-athlete-state-replay-plan.ts --disposable --local",
    "db:activity-file-ingestions:test": "tsx scripts/verify-activity-file-ingestions.ts --disposable --local",
    "db:benchmark:planned-day-summary": "tsx scripts/planned-day-summary-benchmark.ts --disposable --local",
    "db:coaching:foundation:test": "tsx scripts/verify-coaching-foundation.ts --disposable --local",
    "db:coaching:authorization:test": "tsx scripts/verify-athlete-read-authorization.ts --disposable --local",
    "multisport:storage-api-verify": "tsx scripts/verify-isolated-storage-api.ts",
    "multisport:storage-api-verify:current": "tsx scripts/verify-isolated-storage-api.ts --expected-count=45",
    "db:drizzle:studio": "tsx scripts/with-local-db-url.ts drizzle-kit studio --config drizzle.config.ts",
    "self-host:up": "tsx scripts/local-db-command.ts start",
    "self-host:down": "tsx scripts/local-db-command.ts stop",
    "functions:serve": "tsx scripts/local-db-command.ts functions serve",
    "functions:deploy": "tsx scripts/local-db-command.ts functions deploy",
    "functions:new": "tsx scripts/local-db-command.ts functions new",
    "seed-templates": "tsx scripts/seed-templates.ts",
    "seed-training-plans": "tsx scripts/seed-training-plan-templates.ts",
    "studio": "pnpm drizzle-kit studio"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "drizzle-kit": "^0.31.10",
    "supabase": "2.115.0",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  }
}
