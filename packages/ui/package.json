  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "pnpm run test:web && pnpm run test:native",
    "test:web": "vitest run",
    "test:native": "jest --config ./jest.config.mjs --runInBand",
    "generate:testing-artifacts": "tsx scripts/generate-testing-artifacts.ts",
    "check:testing-artifacts": "tsx scripts/generate-testing-artifacts.ts --check"
  },
