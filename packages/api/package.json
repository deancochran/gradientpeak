{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./context": {
      "types": "./src/context.ts",
      "default": "./src/context.ts"
    },
    "./query-client": {
      "types": "./src/query-client.ts",
      "default": "./src/query-client.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry.ts",
      "default": "./src/telemetry.ts"
    },
    "./webhooks": {
      "types": "./src/webhooks.ts",
      "default": "./src/webhooks.ts"
    }
  },
  "scripts": {
    "backfill:activity-evidence": "pnpm --filter @repo/db exec tsx ../api/scripts/backfill-activity-evidence.ts",
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:live-db": "vitest run --config vitest.live-db.config.ts",
    "verify:api": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@sentry/node": "^10.64.0",
    "@supabase/supabase-js": "^2.56.0",
    "@tanstack/react-query": "^5.90.6",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@xmldom/xmldom": "^0.8.13",
    "drizzle-orm": "^0.45.2",
    "posthog-node": "^5.40.0",
    "superjson": "^2.2.6",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
}
