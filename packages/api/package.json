{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./capabilities": {
      "types": "./src/capabilities/catalog.ts",
      "default": "./src/capabilities/catalog.ts"
    },
    "./contract-epoch": {
      "types": "./src/contract-epoch.ts",
      "default": "./src/contract-epoch.ts"
    },
    "./context": {
      "types": "./src/context.ts",
      "default": "./src/context.ts"
    },
    "./query-client": {
      "types": "./src/query-client.ts",
      "default": "./src/query-client.ts"
    },
    "./recording-submission": {
      "types": "./src/contracts/recording-submission.ts",
      "default": "./src/contracts/recording-submission.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry.ts",
      "default": "./src/telemetry.ts"
    },
    "./telemetry-sanitizer": {
      "types": "./src/telemetry-sanitizer.mjs",
      "default": "./src/telemetry-sanitizer.mjs"
    },
    "./test-support/client-contract-v1": {
      "types": "./src/test-support/client-contract-v1.ts",
      "default": "./src/test-support/client-contract-v1.ts"
    },
    "./webhooks": {
      "types": "./src/webhooks.ts",
      "default": "./src/webhooks.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "seed-system-routes": "tsx scripts/seed-system-routes.ts",
    "reprocess-profile-activity-analysis": "tsx scripts/reprocess-profile-activity-analysis.ts",
    "test": "vitest run",
    "test:live-db": "vitest run --config vitest.live-db.config.ts",
    "test:activity-ingestion:disposable": "tsx scripts/activity-ingestion.disposable.test.ts --disposable --local",
    "test:planned-sessions:disposable": "tsx scripts/planned-sessions.disposable.test.ts --disposable --local",
    "test:calibration-history:disposable": "tsx scripts/completed-activity-calibration-history.disposable.test.ts --disposable --local"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@sentry/node": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@xmldom/xmldom": "^0.8.15",
    "drizzle-orm": "^0.45.2",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
