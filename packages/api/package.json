{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./contract-epoch": {
      "types": "./src/contract-epoch.ts",
      "default": "./src/contract-epoch.ts"
    },
    "./context": {
      "types": "./src/context.ts",
      "default": "./src/context.ts"
    },
    "./query-client": {
      "types": "./src/query-client.ts",
      "default": "./src/query-client.ts"
    },
    "./recording-submission": {
      "types": "./src/contracts/recording-submission.ts",
      "default": "./src/contracts/recording-submission.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry.ts",
      "default": "./src/telemetry.ts"
    },
    "./telemetry-sanitizer": {
      "types": "./src/telemetry-sanitizer.mjs",
      "default": "./src/telemetry-sanitizer.mjs"
    },
    "./webhooks": {
      "types": "./src/webhooks.ts",
      "default": "./src/webhooks.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "benchmark:activity-plan-derived-metrics": "RUN_ACTIVITY_PLAN_DERIVED_METRICS_BENCHMARK=1 vitest run src/utils/__tests__/activity-plan-derived-metrics.benchmark.test.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "seed-system-routes": "tsx scripts/seed-system-routes.ts",
    "test": "vitest run",
    "test:live-db": "vitest run --config vitest.live-db.config.ts",
    "verify:api": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@sentry/node": "^10.68.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@xmldom/xmldom": "^0.8.13",
    "drizzle-orm": "^0.45.2",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
